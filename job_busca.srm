#!/bin/bash
#SBATCH --job-name=busca-logs
#SBATCH --partition=sequana_cpu_dev
#SBATCH --nodes=1
#SBATCH --ntasks=4
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=1
#SBATCH --time=00:10:00
#SBATCH --output=slurm-%j.out

# Carregar a mesma versao de MPI usada na compilacao
module load openmpi/gnu/4.1.4_sequana

# Diretorio de execucao
cd "$SCRATCH/busca_logs_t2" || exit 1

# Parametros configuraveis
MODO=${MODO:-static}
TERMO=${TERMO:-ERROR}
DATASET=${DATASET:-logs}

echo "Job: $SLURM_JOB_ID"
echo "Processos MPI: $SLURM_NTASKS"
echo "Modo: $MODO"
echo "Dataset: $DATASET"
echo "Termo: $TERMO"

# Busca distribuida
mpirun -np "$SLURM_NTASKS" \
    ./busca_logs \
    --dir "$DATASET" \
    --search "$TERMO" \
    --mode "$MODO" \
    > "resultados/${MODO}-${TERMO}-${SLURM_JOB_ID}.txt"